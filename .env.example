# CONEXAO COM BANCO DE DADOS ORACLE
DB_USER=
DB_PASSWORD=
DB_CONNECT_STRING=
ORACLE_CLIENT_LIB=/opt/oracle/instantclient_21_9

# DEMAIS CONEXOES
CONEXAO_PORT=7001
GESTLOG_PORT=7002
OFXCONCILIA_PORT=7003
GESTPRO_PORT=7004
GESTFIN_PORT=7005
GESTFIN_RECEBER_PORT=7006
APP_GESTPRO_PORT=7007
EVOLUTION_PORT=7008
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_TARGET_NUMBER=
EVOLUTION_TARGET_GROUP_JID=
ZAPHUB_EVOLUTION_LOG_PATH=
ZAPHUB_EVOLUTION_LOG_POLL_MS=1000
ZAPHUB_EVOLUTION_WEBHOOK_URL=http://127.0.0.1:7008/api/zaphub/evolution/sync-event

# Prisma / Evolution PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/evolutiondb?schema=public"

# Frontend (opcional; use .env.local)
# VITE_API_URL=/api
